{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "Revitalize the block outline.",
	"authors": ["Tektonikal"],
    "contributors": ["kr1v", "awruff", "Wyvest", "BridgeSense"],
	"contact": {
		"homepage": "https://modrinth.com/mod/custom-block-highlight",
		"sources": "https://github.com/Tektonikal/CustomBlockHighlight",
		"issues": "https://github.com/Tektonikal/CustomBlockHighlight/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/customblockhighlight/icon.png",
	"environment": "client",
	"entrypoints": {
		"modmenu": [
			"tektonikal.customblockhighlight.config.ModMenuIntegration"
		],
		"main": [
          "tektonikal.customblockhighlight.CustomBlockHighlight"
		],
